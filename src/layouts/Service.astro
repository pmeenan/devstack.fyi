---
import { getCollection, type CollectionEntry } from 'astro:content';
import Base from './Base.astro';
import { CATEGORIES } from '@lib/taxonomy';
import Sources from '@components/Sources.astro';
import StatusBadge from '@components/StatusBadge.astro';
import { contentPath, entryPath } from '@lib/urls';
interface Props {
  productSlug?: string;
  service: CollectionEntry<'services'>;
  page?: CollectionEntry<'pages'>;
  pages: CollectionEntry<'pages'>[];
}
const { service, page, pages, productSlug } = Astro.props;
const entry = page ?? service;
const area = service.data.areas.find((item) => item.id === page?.data.area);
const overviewId = area ? `${service.id}/${area.id}` : service.id;
const navigationPages = pages.filter((item) =>
  area ? item.data.area === area.id && item.id !== overviewId : !item.data.area,
);
const product = page
  ? (await getCollection('products', (item) => item.id === page.id))[0]
  : undefined;
---

<Base
  title={page
    ? `${page.data.title} · ${service.data.title}`
    : service.data.title}
  summary={entry.data.summary}
  sourcePath={contentPath(entry.id)}
>
  <nav class="breadcrumbs" aria-label="Breadcrumb">
    <a href="/">Catalog</a><span aria-hidden="true">/</span>
    {
      page ? (
        <a href={entryPath(service.id)}>{service.data.title}</a>
      ) : (
        <span aria-current="page">{service.data.title}</span>
      )
    }
    {
      area && (
        <>
          <span aria-hidden="true">/</span>
          <details class="area-switcher">
            <summary aria-label={`Topic area: ${area.name}. Switch area`}>
              {area.name}
            </summary>
            <ul>
              {service.data.areas.map((item) => (
                <li>
                  {item.status === 'available' ? (
                    <a
                      href={entryPath(`${service.id}/${item.id}`)}
                      aria-current={
                        item.id === area.id ? 'location' : undefined
                      }
                    >
                      {item.name}
                    </a>
                  ) : (
                    <span>
                      {item.name} <small>Planned</small>
                    </span>
                  )}
                </li>
              ))}
              <li>
                <a href={entryPath(service.id)}>All topic areas</a>
              </li>
            </ul>
          </details>
        </>
      )
    }
    {
      page && page.id !== overviewId && (
        <>
          <>
            <span aria-hidden="true">/</span>
            <span aria-current="page">{page.data.title}</span>
          </>
        </>
      )
    }
  </nav>
  <div class="service-heading">
    <p class="eyebrow">{CATEGORIES[service.data.category].name}</p>
    <h1>{entry.data.title}</h1>
    <StatusBadge
      lastVerified={entry.data.lastVerified}
      status={service.data.status}
    />
    <p class="intro">{entry.data.summary}</p>
    <p class="metadata">
      <span
        >Last verified: <time
          datetime={entry.data.lastVerified.toISOString().slice(0, 10)}
          >{entry.data.lastVerified.toISOString().slice(0, 10)}</time
        ></span
      ><span aria-hidden="true">·</span><a href={service.data.website}
        >Vendor website</a
      >
    </p>
  </div>
  {
    (area || !service.data.areas.length) && (
      <div class="service-navigation">
        <nav
          class="product-tabs"
          aria-label={area ? `More in ${area.name}` : 'More on this service'}
        >
          <a
            href={entryPath(overviewId)}
            aria-current={entry.id === overviewId ? 'page' : undefined}
          >
            Overview
          </a>
          {navigationPages.map((item) => (
            <a
              href={entryPath(item.id)}
              aria-current={item.id === page?.id ? 'page' : undefined}
            >
              {item.data.title}
            </a>
          ))}
        </nav>
        <nav class="page-sections" aria-label="On this page">
          {productSlug && (
            <>
              <a href="#architecture">Architecture</a>
              <a href="#components">Components &amp; connections</a>
              <a href="#api-example">API example</a>
              {productSlug === 'workflows' && <a href="#triggers">Triggers</a>}
              <a href="#latency">Latency</a>
              <a href="#local-development">Local development</a>
              <a href="#deployment">Deployment</a>
              <a href={`#product-${productSlug}`}>Usage limits</a>
            </>
          )}
          {page?.data.sections.map((section) => (
            <a href={`#${section.id}`}>{section.name}</a>
          ))}
          <a href="#page-sources">Sources</a>
        </nav>
      </div>
    )
  }
  {
    product && (
      <nav class="official-docs" aria-label="Official documentation">
        <a href={product.data.docs}>
          {product.data.name} docs <span aria-hidden="true">↗</span>
        </a>
        {product.data.apiReferences.map(({ title, url }) => (
          <a href={url}>
            {product.data.name} {title} <span aria-hidden="true">↗</span>
          </a>
        ))}
      </nav>
    )
  }
  <article class="prose"><slot /></article>
  <section id="page-sources">
    <h2>Sources and verification</h2><Sources
      sources={entry.data.sources}
      lastVerified={entry.data.lastVerified}
    />
  </section>
</Base>

<style>
  .breadcrumbs {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4rem 0.6rem;
  }
  .area-switcher {
    position: relative;
    max-width: 100%;
  }
  .area-switcher summary {
    cursor: pointer;
    color: var(--accent);
    text-decoration: underline;
  }
  .area-switcher ul {
    position: absolute;
    top: 100%;
    left: 0;
    z-index: 5;
    width: 19rem;
    max-width: calc(100vw - 3rem);
    padding: 0.5rem;
    margin: 0.5rem 0 0;
    list-style: none;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    box-shadow: 0 4px 12px #0002;
  }
  .area-switcher li > a,
  .area-switcher li > span {
    display: block;
    padding: 0.55rem;
  }
  .area-switcher li > span {
    color: var(--muted);
  }
  .area-switcher small {
    display: block;
  }
  .area-switcher [aria-current] {
    font-weight: 700;
  }
  @media (max-width: 600px) {
    .area-switcher[open] {
      flex-basis: 100%;
    }
    .area-switcher ul {
      position: static;
      width: 100%;
      max-width: 100%;
    }
  }

  .official-docs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin: 1rem 0 1.4rem;
  }
  .official-docs a {
    border: 1px solid var(--accent);
    border-radius: 6px;
    background: var(--surface);
    padding: 0.55rem 0.8rem;
    font-size: 0.85rem;
    font-weight: 600;
    text-decoration: none;
  }
  .official-docs a:hover {
    background: var(--soft);
    text-decoration: underline;
  }

  .service-navigation {
    --navigation-surface: var(--soft);
    margin: 1.5rem 0 2rem;
  }
  .product-tabs {
    position: relative;
    z-index: 1;
    margin-bottom: -1px;
    display: flex;
    overflow-x: auto;
    gap: 0.2rem;
    padding: 0.25rem 0 0;
    scrollbar-width: none;
  }
  .product-tabs::-webkit-scrollbar {
    display: none;
  }
  .product-tabs a {
    flex: 0 0 auto;
    padding: 0.75rem 0.85rem;
    border: 1px solid transparent;
    border-bottom: 0;
    border-radius: 9px 9px 0 0;
    text-decoration: none;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--muted);
  }
  .product-tabs a:hover {
    color: var(--accent);
  }
  .product-tabs a[aria-current='page'] {
    color: var(--accent);
    background: var(--navigation-surface);
    border-color: var(--border);
    box-shadow: 0 1px 0 var(--navigation-surface);
    position: relative;
    z-index: 1;
  }
  .page-sections {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.3rem;
    padding: 0.9rem 1.1rem;
    background: var(--navigation-surface);
    border: 1px solid var(--border);
    border-radius: 0 0 9px 9px;
    font-size: 0.8rem;
  }
  .page-sections a {
    text-decoration: none;
    padding-block: 0.2rem;
  }
  .page-sections a:hover {
    text-decoration: underline;
  }
  .product-tabs a:focus-visible {
    outline-offset: -4px;
  }
</style>
<script>
  document
    .querySelectorAll<HTMLDetailsElement>('.area-switcher')
    .forEach((menu) => {
      menu.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') {
          menu.open = false;
          menu.querySelector('summary')?.focus();
        }
      });
    });
  // Reveal the selected product in the horizontal tab strip on narrow screens.
  document.querySelectorAll<HTMLElement>('.product-tabs').forEach((nav) => {
    const selected = nav.querySelector<HTMLElement>('[aria-current="page"]');
    if (selected)
      nav.scrollLeft =
        selected.offsetLeft - (nav.firstElementChild as HTMLElement).offsetLeft;
  });
</script>
