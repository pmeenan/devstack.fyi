---
import type { CollectionEntry } from 'astro:content';
import { entryPath } from '@lib/urls';
interface Props {
  service: CollectionEntry<'services'>;
  pages: CollectionEntry<'pages'>[];
  products: CollectionEntry<'products'>[];
}
const { service, pages, products } = Astro.props;
---

<section aria-labelledby="topic-areas">
  <h2 id="topic-areas">Explore a topic area</h2>
  <ul class="topic-directory">
    {
      service.data.areas.map((area) => (
        <li id={`area-${area.id}`}>
          <p class="eyebrow">
            {area.status === 'available' ? 'Available guides' : 'Planned'}
          </p>
          <h3>
            {area.status === 'available' ? (
              <a href={entryPath(`${service.id}/${area.id}`)}>
                {area.name} <span aria-hidden="true">→</span>
              </a>
            ) : (
              area.name
            )}
          </h3>
          <p>{area.summary}</p>
          {area.status === 'available' && (
            <ul class="area-products">
              {products
                .filter(
                  (product) =>
                    product.data.area === area.id &&
                    pages.some((page) => page.id === product.id),
                )
                .map((product) => (
                  <li id={`product-${product.id.split('/').at(-1)}`}>
                    <a href={entryPath(product.id)}>{product.data.name}</a>
                  </li>
                ))}
            </ul>
          )}
        </li>
      ))
    }
  </ul>
</section>
<style>
  .topic-directory {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    padding: 0;
    list-style: none;
  }
  .topic-directory > li {
    padding: 1.3rem;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--surface);
  }
  .topic-directory > li:has(.area-products) {
    border-top: 3px solid var(--green);
  }
  .topic-directory h3 {
    margin: 0.4rem 0;
    font-size: 1.2rem;
  }
  .topic-directory p:not(.eyebrow) {
    color: var(--muted);
    font-size: 0.9rem;
  }
  .area-products {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1rem;
    list-style: none;
    padding: 0;
    font-size: 0.875rem;
  }
  .area-products li:target {
    background: var(--accent-soft);
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }
  @media (max-width: 600px) {
    .topic-directory {
      grid-template-columns: 1fr;
    }
  }
</style>
