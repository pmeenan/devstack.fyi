---
import type { CollectionEntry } from 'astro:content';
import Sources from './Sources.astro';
import StatusBadge from './StatusBadge.astro';
import { editUrl } from '@lib/urls';
interface Props {
  service: CollectionEntry<'services'>;
  products: CollectionEntry<'products'>[];
  detail?: boolean;
}

const { service, products, detail = false } = Astro.props;
const LimitsHeading = detail ? 'h2' : 'h3';
const SourceHeading = detail ? 'h3' : 'h4';
const groups = [
  ...service.data.groups,
  { id: undefined, name: 'Products', summary: undefined },
]
  .map((group) => ({
    ...group,
    products: products.filter((product) => product.data.group === group.id),
  }))
  .filter((group) => group.products.length);
const kinds = {
  vendor: 'Vendor tooling',
  'open-source': 'Open source',
  mock: 'Mock',
  remote: 'Remote service',
};
---

{
  !detail && groups.length > 0 && (
    <nav class="section-nav" aria-label="Product groups">
      {groups.map((group) => (
        <a href={`#products-${group.id ?? 'other'}`}>{group.name}</a>
      ))}
    </nav>
  )
}
{
  groups.map((group) => (
    <section id={`products-${group.id ?? 'other'}`} class="product-group">
      {!detail && <h2>{group.name}</h2>}
      {!detail && group.summary && <p>{group.summary}</p>}
      {!detail && (
        <div
          class="table-scroll"
          role="region"
          aria-label={`${group.name}: capabilities and local development`}
          tabindex="0"
        >
          <table>
            <>
              <caption>
                {group.name}: capabilities and local development
              </caption>
              <thead>
                <tr>
                  <>
                    <th scope="col">Product</th>
                    <th scope="col">What you get</th>
                    <th scope="col">Local development</th>
                  </>
                </tr>
              </thead>
            </>
            <tbody>
              {group.products.map(({ id, data }) => (
                <tr>
                  <th scope="row">
                    <a href={data.docs}>{data.name}</a>
                    <StatusBadge lastVerified={data.lastVerified} />
                    {data.aliases.length > 0 && (
                      <p class="muted">Also: {data.aliases.join(', ')}</p>
                    )}
                    <a class="small" href={`#product-${id.split('/')[1]}`}>
                      Limits &amp; sources
                    </a>
                  </th>
                  <td>
                    {data.capability}
                    {data.notes && <p>{data.notes}</p>}
                  </td>
                  <td>
                    <ul class="local-options">
                      {data.localDev.map((option) => (
                        <li>
                          <span class="option-kind">{kinds[option.kind]}</span>
                          {option.name && (
                            <strong>
                              {option.url ? (
                                <a href={option.url}>{option.name}</a>
                              ) : (
                                option.name
                              )}
                            </strong>
                          )}
                          <p>{option.summary}</p>
                          {!option.name && option.url && (
                            <a href={option.url}>Documentation</a>
                          )}
                        </li>
                      ))}
                    </ul>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}
      {detail &&
        group.products.map(({ data }) => (
          <section id="local-development">
            <h2>Local development</h2>
            {data.localDev.map((option) => (
              <section>
                <h3>
                  {option.url ? (
                    <a href={option.url}>{option.name ?? kinds[option.kind]}</a>
                  ) : (
                    (option.name ?? kinds[option.kind])
                  )}
                </h3>
                <p>{option.summary}</p>
              </section>
            ))}
            <slot name="local-content" />
            {data.notes && (
              <aside class="product-note">
                <strong>Keep in mind</strong>
                <p>{data.notes}</p>
              </aside>
            )}
            <StatusBadge lastVerified={data.lastVerified} />
          </section>
        ))}
      {detail && <slot name="deployment" />}
      {group.products.map(({ id, data }) => (
        <section class="product-detail" id={`product-${id.split('/')[1]}`}>
          <LimitsHeading>{data.name}: usage limits</LimitsHeading>
          <StatusBadge lastVerified={data.limits.lastVerified} />
          {data.limits.metrics.length > 0 && (
            <div
              class="table-scroll"
              role="region"
              aria-label={`${data.name} usage limits`}
              tabindex="0"
            >
              <table>
                <caption>{data.name}: limits by plan tier</caption>
                <thead>
                  <tr>
                    <th scope="col">Metric</th>
                    {data.limits.tiers.map((tier) => (
                      <th scope="col">
                        {tier.name}
                        {tier.note && <p class="muted">{tier.note}</p>}
                      </th>
                    ))}
                  </tr>
                </thead>
                <tbody>
                  {data.limits.metrics.map((metric) => (
                    <tr>
                      <th scope="row">
                        {metric.name}
                        {metric.note && <p class="muted">{metric.note}</p>}
                      </th>
                      {data.limits.tiers.map((tier) => (
                        <td>{metric.values[tier.id]}</td>
                      ))}
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )}
          {data.limits.note && <p>{data.limits.note}</p>}
          <SourceHeading>Limits sources</SourceHeading>
          <Sources
            sources={data.limits.sources}
            lastVerified={data.limits.lastVerified}
          />
          <SourceHeading>Product and local-development sources</SourceHeading>
          <Sources sources={data.sources} lastVerified={data.lastVerified} />
          <a
            class="small"
            href={editUrl(
              `services/${service.id}/content/products/${id.split('/')[1]}.yaml`,
            )}
          >
            Edit {data.name}
          </a>
        </section>
      ))}
    </section>
  ))
}

<style>
  th > a.small {
    display: block;
    margin-top: 0.5rem;
  }
</style>
