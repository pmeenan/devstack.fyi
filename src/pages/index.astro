---
import Base from '../layouts/Base.astro';
import { loadContent } from '@lib/content';
import { CATEGORIES, type CategoryId } from '@lib/taxonomy';
import { entryPath } from '@lib/urls';
import { warnStale } from '@lib/stale';
const content = await loadContent();
warnStale(content);
const categories = (
  Object.entries(CATEGORIES) as [CategoryId, { name: string; order: number }][]
).sort((a, b) => a[1].order - b[1].order);
---

<Base
  title="Service catalog"
  summary="Practical notes on cloud services: product capabilities, local development, plan limits, and configuration."
  sourcePath="src/pages/index.astro"
>
  <p class="eyebrow">DEVELOPER-TO-DEVELOPER FIELD NOTES</p>
  <h1>Know your <span class="highlight">stack.</span></h1>
  <p class="intro">
    What the product names mean, what to run locally, and what to configure.
  </p>
  {
    categories.map(([id, category]) => {
      const services = content.services.filter(
        (service) => service.data.category === id,
      );
      return (
        services.length > 0 && (
          <section class="catalog-category">
            <>
              <h2>{category.name}</h2>
              <ul class="catalog-grid">
                {services.map((service) => (
                  <li>
                    <a class="catalog-card" href={entryPath(service.id)}>
                      <span class="service-mark" aria-hidden="true">
                        {service.data.title.slice(0, 2).toUpperCase()}
                      </span>
                      <div>
                        <div class="card-heading">
                          <h3>{service.data.title}</h3>
                          <span class:list={['badge', service.data.status]}>
                            {service.data.status === 'draft'
                              ? 'Draft'
                              : 'Reviewed'}
                          </span>
                        </div>
                        <p>{service.data.summary}</p>
                      </div>
                      <span class="card-arrow" aria-hidden="true">
                        ↗
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </>
          </section>
        )
      );
    })
  }
</Base>
