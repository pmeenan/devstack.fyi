---
import { render, type CollectionEntry } from 'astro:content';
import CodeBlock from '@components/CodeBlock.astro';
import Service from '../../layouts/Service.astro';
import { loadContent } from '@lib/content';
export async function getStaticPaths() {
  const { services, pages } = await loadContent();
  return pages.map((page) => {
    const [service, ...segments] = page.id.split('/');
    return {
      params: { service, page: segments.join('/') },
      props: {
        page,
        service: services.find((entry) => entry.id === service)!,
        pages: pages.filter((entry) => entry.id.startsWith(`${service}/`)),
      },
    };
  });
}
interface Props {
  page: CollectionEntry<'pages'>;
  service: CollectionEntry<'services'>;
  pages: CollectionEntry<'pages'>[];
}
const { page, service, pages } = Astro.props;
const { Content } = await render(page);
---

<Service service={service} page={page} pages={pages}>
  <Content components={{ pre: CodeBlock }} />
</Service>
