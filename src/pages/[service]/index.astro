---
import { render, type CollectionEntry } from 'astro:content';
import CodeBlock from '@components/CodeBlock.astro';
import Service from '../../layouts/Service.astro';
import TopicDirectory from '@components/TopicDirectory.astro';
import Products from '@components/Products.astro';
import { loadContent } from '@lib/content';
export async function getStaticPaths() {
  const { services, pages, products } = await loadContent();
  return services.map((service) => ({
    params: { service: service.id },
    props: {
      service,
      products: products.filter((product) =>
        product.id.startsWith(`${service.id}/`),
      ),
      pages: pages.filter((page) => page.id.startsWith(`${service.id}/`)),
    },
  }));
}
interface Props {
  service: CollectionEntry<'services'>;
  pages: CollectionEntry<'pages'>[];
  products: CollectionEntry<'products'>[];
}
const { service, pages, products } = Astro.props;
const { Content } = await render(service);
---

<Service service={service} pages={pages}>
  <Content components={{ pre: CodeBlock }} />
  {
    service.data.areas.length > 0 && (
      <TopicDirectory service={service} pages={pages} products={products} />
    )
  }
  <Products
    service={service}
    products={products.filter(
      (product) => !pages.some((page) => page.id === product.id),
    )}
  />
</Service>
